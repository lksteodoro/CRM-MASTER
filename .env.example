# Copie este arquivo para `.env` e preencha com as chaves do seu projeto Supabase.
# Painel do Supabase → Project Settings → API

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key

# NUNCA coloque a SERVICE_ROLE_KEY aqui.
# Ela ignora RLS e tudo em VITE_* é embutido no bundle enviado ao navegador.
